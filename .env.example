# REVEAL: Retrieval and Evidence-based Validated Interpretation Analysis for gene Lists
# =====================================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT:
# - Never commit .env to version control!
# - Use format: KEY=value (no spaces around the equals sign)

# ============================================================================
# REQUIRED: OpenAI API Key
# ============================================================================
# Used for: Gene extraction, interpretation, literature ranking
# Get yours at: https://platform.openai.com/api-keys
# Cost estimate: ~$0.05-0.15 per 5-gene query (using gpt-4.1-mini)
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================================================
# REQUIRED: NCBI Email
# ============================================================================
# Used for: PubMed literature search, gene description lookups
# NCBI requires an email for API identification (no registration needed)
# Just use your real email address
NCBI_EMAIL=your.email@example.com

# ============================================================================
# OPTIONAL: NCBI API Key
# ============================================================================
# Used for: Higher PubMed rate limits (10 req/sec instead of 3)
# Get yours at: https://www.ncbi.nlm.nih.gov/account/ -> Settings -> API Key
#
# IMPORTANT: If you don't have an NCBI API key, DELETE or COMMENT OUT the line
# below entirely. Do NOT leave it blank (NCBI_API_KEY=) as this causes 400 errors.
#
# If you have an API key, uncomment and add it:
# NCBI_API_KEY=your-ncbi-api-key-here

# ============================================================================
# NOTE: Additional Settings
# ============================================================================
# The following settings are configured in src/config.py and are not currently
# read from environment variables. Edit src/config.py directly if needed:
#
# - LOG_LEVEL: Default is INFO
# - DEFAULT_DB_PATH: Default is src/database/gene_database.sqlite
